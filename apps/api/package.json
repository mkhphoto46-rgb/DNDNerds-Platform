{
    "name": "@dndnerds/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev:stack": "node dev/local-stack.mjs",
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
        "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
        "db:seed": "tsx src/db/seed.ts",
        "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
        "reconcile:refunds": "node dist/jobs/reconcile-refunds.js",
        "reconcile:payouts": "node dist/jobs/reconcile-payouts.js",
        "reconcile:finance": "npm run reconcile:refunds && npm run reconcile:payouts",
        "worker:finance": "node dist/jobs/finance-reconciliation-worker.js",
        "worker:finance:check": "node dist/jobs/finance-reconciliation-worker.js --check",
        "worker:finance:once": "node dist/jobs/finance-reconciliation-worker.js --once",
        "worker:notifications:check": "node dist/jobs/seller-notification-worker.js --check",
        "worker:notifications:once": "node dist/jobs/seller-notification-worker.js --once"
    },
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/multipart": "10.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@node-rs/argon2": "^2.2.1",
        "dotenv": "^18.0.5",
        "drizzle-orm": "^0.45.3",
        "fastify": "^5.12.5",
        "nodemailer": "^7.0.13",
        "postgres": "^3.4.9",
        "prom-client": "^15.1.3",
        "redis": "^5.12.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/nodemailer": "^7.0.12",
        "drizzle-kit": "^0.31.11",
        "embedded-postgres": "18.4.0-beta.17",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
