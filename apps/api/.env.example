# Development settings for the API. `npm run dev:stack` copies this file to
# .env on first run and fills in the database, Redis and key values. Never
# commit .env, and never put production secrets here.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
MARKETPLACE_DEFAULT_COMMISSION_BPS=500

DATABASE_URL=
REDIS_URL=

# Development providers: email goes to logs/email-outbox.log; payments and
# payouts use the mock providers. Production startup rejects both.
EMAIL_PROVIDER=development
PAYMENT_PROVIDER=mock
PAYOUT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=

# 32-byte keys: MFA as 64 hex characters, payout destinations as base64.
MFA_ENCRYPTION_KEY=
PAYOUT_DESTINATION_ENCRYPTION_KEY=
NOTIFICATION_DESTINATION_KEY_HEX=

# Optional features, off by default.
DND_ENABLE_TELEGRAM_PAIRING=false
DND_ENABLE_IN_APP_NOTIFICATION_WORKER=false
DND_ENABLE_MOCK_SELLER_REFUNDS=false
